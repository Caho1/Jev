# jev-playwright-mcp — environment template.
#
# Usage: `cp .env.example .env` in the repo root. At startup the proxy
# auto-loads a `.env` file from the package root (dotenv conventions:
# `#` comments, optional `export ` prefix, quoted values).
#
# Precedence: CLI flags > process environment (e.g. your MCP config's
# "env" block — see examples/) > this .env file > defaults. Values already
# set in the process environment are never overwritten by .env.
#
# Escape hatch: set JEV_MCP_NO_ENV_FILE=1 to skip .env loading entirely
# (forces "no key = pure passthrough" stock behavior).

# ── Required for Jev features ──────────────────────────────────────────────
# Jev (TypeSafe) API key. Without it the proxy runs as pure passthrough —
# stock Playwright MCP behavior (the blockTools policy still applies).
# Alternative variable name: JEV_MCP_API_KEY (TYPESAFE_API_KEY wins).
TYPESAFE_API_KEY=

# ── Optional JEV_MCP_* settings (CLI flags take precedence over env) ──────
# Mode: off | annotate | gate | all. Default: all
#JEV_MCP_MODE=all

# Session Jev spend cap in USD; exceeded → passthrough + one-time warning. Default: 1.0
#JEV_MCP_BUDGET_USD=1.0

# Jev model id. Default: jev-latest
#JEV_MCP_MODEL=jev-latest

# Injection spans with P >= this are masked out of page content. Default: 0.5
#JEV_MCP_INJECTION_THRESHOLD=0.5

# Snapshot regions with relevance below this are collapsed (needs a goal set). Default: 0.35
#JEV_MCP_PRUNE_KEEP_THRESHOLD=0.35

# A gate "destructive" verdict at or above this probability blocks the call. Default: 0.6
#JEV_MCP_DESTRUCTIVE_THRESHOLD=0.6

# Set to 1/true to disable verdict caching (cache is keyed by content hash). Default: unset (cache on)
#JEV_MCP_NO_CACHE=1

# Set to 1/true/on/yes to skip loading this .env file at startup entirely. Default: unset (load)
#JEV_MCP_NO_ENV_FILE=1

# ── Optional upstream (Playwright MCP) hints ──────────────────────────────
# Explicit browser executable path. If unset, the proxy auto-detects a
# chromium binary from the ms-playwright cache and injects it for you.
# Equivalent upstream flag (after "--"): --executable-path <path>
#PLAYWRIGHT_MCP_EXECUTABLE_PATH=
