@@ -0,0 +1,215 @@
+/** Strip volatile AX indices, retaining text, values, hierarchy and origin. */
+export function semanticState(state) {
+  return state.replace(/^(\s*)\d+ /gm, '$1');
+}
+/** Local, conservative recognizers: ordinary article mentions never match. */
+export function classifyPage(state) {
+  const headings = state.split('\n').map(l=>l.trim().replace(/^\d+ /,'')).filter(l=>/^(?:标题|heading) /i.test(l));
+  const checks = [
+    ['rate_limited', /^(?:标题|heading) (?:Too many requests|Rate limit exceeded|请求过于频繁)(?:$|[,.:!])/i],
+    ['verification', /^(?:标题|heading) (?:Verify you are human|Just a moment|验证您是人类)(?:$|[,.:!])/i],
+    ['access_denied', /^(?:标题|heading) (?:Access denied|访问被拒绝)(?:$|[,.:!])/i],
+  ];
+  return checks.find(([,re])=>headings.some(h=>re.test(h)))?.[0] || null;
+}
+/** Official CUA adapter. Pass a documented cua App or Tab; never opens a CDP port. */
+export function pageScope(state) {
+  const lines = state.split('\n');
+  const start = lines.findIndex(l => /^\s*\d+ (?:HTML 内容|AXWebArea|web area|WebArea) /.test(l));
+  if (start < 0) throw new Error('No unambiguous rendered web area');
+  if (lines.filter(l => /^\s*\d+ (?:HTML 内容|AXWebArea|web area|WebArea) /i.test(l)).length !== 1) throw new Error('Multiple web areas require a scoped target');
+  const indent = lines[start].match(/^\s*/)[0].length;
+  let end = start + 1;
+  while (end < lines.length && (!lines[end].trim() || lines[end].match(/^\s*/)[0].length > indent)) end++;
+  const address=lines.find(l=>/^\s*\d+ .*(?:地址和搜索栏|Address and search bar), Value: /.test(l));
+  const url=address?.match(/Value: (.*?)(?:, Placeholder:|$)/)?.[1];
+  return lines.slice(start, end).join('\n')+(url?'\nPAGE_URL: '+url:'');
+}
+function parseNodes(state) {
+  return state.split('\n').flatMap(line=>{
+    const m=line.trim().match(/^(\d+) (.*)$/u);
+    return m ? [{index:Number(m[1]),description:m[2]}] : [];
+  });
+}
+function resolveNodes(nodes, rule, pattern=new RegExp(rule.pattern,'u')) {
+  let found;
+  for(const node of nodes)if(pattern.test(node.description)) {
+    if(found)throw new Error('Ambiguous target: '+rule.id);
+    found=node;
+  }
+  return found;
+}
+export function locate(state, rule) {
+  return resolveNodes(parseNodes(state),rule);
+}
+export async function runOfficial({target, task, decide, maxSteps=20, maxMs=60000, emit=()=>{}}) {
+  if(!task||typeof task.goal!=='string'||!task.goal.trim()||typeof task.scope!=='string'||!task.scope||
+     !['app','tab'].includes(task.surface)||!Array.isArray(task.success)||!task.success.length||
+     !Array.isArray(task.actions)||!task.actions.length||!Number.isInteger(maxSteps)||maxSteps<1||maxSteps>100||
+     !Number.isFinite(maxMs)||maxMs<1||maxMs>600000)throw new Error('Invalid task or budget');
+  const ids=new Set();
+  for(const p of [task.scope,...task.success,...(task.context||[])]) {
+    if(typeof p!=='string'||!p)throw new Error('Invalid assertion');new RegExp(p,'mu');
+  }
+  for(const a of task.actions) {
+    if(typeof a.id!=='string'||!a.id||['DONE','WAIT','BLOCKED'].includes(a.id)||ids.has(a.id)||
+       !['click','set_value','press_key'].includes(a.op)||typeof a.pattern!=='string'||!a.pattern)throw new Error('Invalid action');
+    ids.add(a.id);new RegExp(a.pattern,'u');
+    for(const p of [a.requires,a.unless,a.after])if(p!==undefined){if(typeof p!=='string'||!p)throw new Error('Invalid condition');new RegExp(p,'mu');}
+    if(a.op==='set_value'&&(typeof a.text!=='string'||a.text.length>4000))throw new Error('Invalid text slot');
+    if(a.op==='press_key'&&!['Return','Tab','Escape'].includes(a.key))throw new Error('Unsupported key');
+  }
+  for(const a of task.actions) {
+    if(a.dependsOn!==undefined && (!Array.isArray(a.dependsOn)||a.dependsOn.some(id=>!ids.has(id)||id===a.id)))throw new Error('Invalid dependencies');
+    if(a.dependsOn?.some(id=>!task.actions.find(r=>r.id===id).after))throw new Error('Dependencies require verified postconditions');
+    if(a.once && !a.after)throw new Error('Once requires a verified postcondition');
+    if(a.once!==undefined && typeof a.once!=='boolean')throw new Error('Invalid once flag');
+  }
+  const selectors=new Map(task.actions.map(a=>[a.id,new RegExp(a.pattern,'u')]));
+  const visiting=new Set(),visited=new Set();
+  const visit=id=>{if(visiting.has(id))throw new Error('Cyclic dependencies');if(visited.has(id))return;visiting.add(id);for(const dep of task.actions.find(a=>a.id===id).dependsOn||[])visit(dep);visiting.delete(id);visited.add(id);};
+  for(const id of ids)visit(id);
+  // Compile once per task, not once per node or loop iteration.
+  const compiled=new Map();
+  const matches=(p,s)=>{if(!compiled.has(p))compiled.set(p,new RegExp(p,'mu'));return compiled.get(p).test(s);};
+  const started = performance.now(), rows=[], history=[], completed=new Set();
+  const metrics={observations:0,observation_ms:0,decisions:0,decision_ms:0,execution_ms:0,host_rules:0,context_bytes:0};
+  let actionsExecuted=0,waits=0;
+  const budget=()=>{if(performance.now()-started>=maxMs){const e=new Error('Task time budget exhausted');e.code='time_budget';throw e;}};
+  const attempts=new Set();
+  const scoped=s=>new RegExp(task.scope,'mu').test(s.split('\n').filter((l,i)=>i===0||l.startsWith('PAGE_URL:')).join('\n'));
+  const read = async () => {
+    for(let probe=0;probe<3;probe++) {
+      budget();
+      const observed=performance.now();let raw;
+      try {raw=await target.getAXState({disableDiffing:true,emit:false});}
+      finally {metrics.observations++;metrics.observation_ms+=performance.now()-observed;}
+      budget();
+      if(/^\s*\d+ (?:HTML 内容|AXWebArea|web area|WebArea) /m.test(raw))return pageScope(raw);
+    }
+    throw new Error('Rendered web area temporarily unavailable');
+  };
+  const result = (status, extra={}) => ({status, task_ms:performance.now()-started, steps:actionsExecuted, metrics, rows, completed:[...completed], ...extra});
+  let state;
+  try {state=await read();}catch(e){return result(e.code||'observation_failed',{error:e.message});}
+  try {
+  for(let step=0;step<=maxSteps;step++) {
+    if(!scoped(state)) return result('scope_changed');
+    const blocked=classifyPage(state);if(blocked)return result('site_blocked',{reason:blocked});
+    if(task.success.every(p=>matches(p,state))) return result('verified');
+    if(step===maxSteps) return result('step_budget');
+    if(performance.now()-started>=maxMs) return result('time_budget');
+    const nodes=parseNodes(state);
+    const candidates=task.actions.flatMap(rule=>{
+      if(rule.once && completed.has(rule.id))return [];
+      if(rule.dependsOn?.some(id=>!completed.has(id)))return [];
+      if(rule.requires && !matches(rule.requires,state))return [];
+      if(rule.unless && matches(rule.unless,state))return [];
+      const found=resolveNodes(nodes,rule,selectors.get(rule.id));
+      return found && !/\(disabled\)/.test(found.description) ? [{...rule,...found}] : [];
+    });
+    if(!candidates.length)return result('no_candidates');
+    const fingerprint=semanticState(state);
+    if(candidates.every(c=>attempts.has(JSON.stringify([c.id,fingerprint]))))return result('repeated_action');
+    const t=performance.now();
+    let decision;
+    const context=state.split('\n').filter((line,i)=>i===0||line.startsWith('PAGE_URL:')||
+      candidates.some(c=>line.trim()===c.index+' '+c.description)||
+      /(?:Loading|加载中|Too many requests|Access denied)/i.test(line)||
+      [...(task.context||[]),...task.success].some(p=>matches(p,line)))
+      .map(l=>l.slice(0,700)).slice(0,100).join('\n');
+    const deterministic=candidates.length===1 && candidates[0].deterministic===true && Boolean(candidates[0].requires);
+    if(!deterministic)metrics.context_bytes+=new TextEncoder().encode(context).length;
+    if(deterministic)metrics.host_rules++;else metrics.decisions++;
+    try { decision=deterministic ? {id:candidates[0].id} : await decide({goal:task.goal,state:context,history:history.slice(-4),candidates:candidates.map(({id,op,description,text,key})=>({id,op,description,text,key})),remainingMs:Math.max(1,maxMs-(performance.now()-started))}); }
+    catch(e) {metrics.decision_ms+=performance.now()-t;rows.push({step,status:'decision_failed',decision_ms:performance.now()-t,error:e.message});return result('decision_failed',{error:e.message});}
+    metrics.decision_ms+=performance.now()-t;
